---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="About Us — Sackrider.org" description="About the Sackrider family.">
  <div class="max-w-2xl mx-auto">
    <header class="mb-8 pb-6 border-b border-zinc-200 dark:border-zinc-800 text-center">
      <h1 class="text-3xl sm:text-4xl font-bold text-zinc-900 dark:text-zinc-100">
        About Us
      </h1>
      <p class="text-sm text-zinc-500 dark:text-zinc-400 mt-2">
        Welcome to the Sackrider family homepage.
      </p>
    </header>

    <div class="prose-content text-center">
      <img
        src="/wp-content/uploads/2006/07/daleandstephanie.jpg"
        alt="Dale and Stephanie Sackrider"
        class="w-72 rounded-2xl mx-auto shadow-md"
      />

      <p class="mt-6 text-lg">
        My wife and I are always excited to meet new members of the Sackrider Family, so if your surname is Sackrider, please write us!
      </p>

      <div class="mt-8 p-6 rounded-2xl bg-zinc-50 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 text-sm inline-block text-left">
        <p class="font-bold text-zinc-900 dark:text-zinc-100">Dale and Stephanie Sackrider</p>
        <p class="mt-2">
          <a href="mailto:dale@sackrider.org" class="text-sky-600 dark:text-sky-400 hover:underline">dale@sackrider.org</a>
        </p>
      </div>
    </div>
  </div>
</BaseLayout>
