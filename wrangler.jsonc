{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sackrider-org",
  "compatibility_date": "2026-09-08",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "dist"
  },
  "routes": [
    {
      "pattern": "sackrider.org/*",
      "zone_name": "sackrider.org"
    },
    {
      "pattern": "www.sackrider.org/*",
      "zone_name": "sackrider.org"
    }
  ]
}
